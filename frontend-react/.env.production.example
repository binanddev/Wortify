# Copy to .env.production.local for a local Netlify build, or import these
# values into Netlify environment variables (Builds scope). Never commit secrets.
# The backend must be reachable from Netlify over public HTTPS.
BACKEND_ORIGIN=https://api.example.com

# Netlify Functions scope (also give BACKEND_ORIGIN Functions scope).
# Set to 1 to check backend health every ten minutes; 0 disables requests.
BACKEND_PING_ENABLED=1
