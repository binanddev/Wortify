# Local development: copy to .env; set WORTIFY_ENV_FILE=.env before running Django.
DJANGO_ENV=development
DJANGO_DATABASE_ENGINE=sqlite
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
STT_PROVIDER=
TTS_PROVIDER=
SPEECH_API_KEY=
STT_MODEL=whisper-1
TTS_MODEL=tts-1
TTS_VOICE=alloy
SPEECH_TIMEOUT=30

# Local frontend server -> backend monitoring (use a random matching secret in production).
BACKEND_MONITOR_SECRET=local-monitor-development-only
