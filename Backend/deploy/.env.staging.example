COMPOSE_PROJECT_NAME=wortify-staging
DJANGO_ENV=staging
PUBLIC_HOST=staging.example.com
DJANGO_SECRET_KEY=
DJANGO_DB_PASSWORD=
DJANGO_DB_NAME=wortify_staging
DJANGO_DB_USER=wortify
DJANGO_HSTS_SECONDS=3600
DJANGO_HSTS_INCLUDE_SUBDOMAINS=0
WEB_CONCURRENCY=2
WEB_THREADS=2
BACKEND_BIND_IP=10.20.0.3

# Shared only between the frontend monitor process and backend, never VITE_*.
BACKEND_MONITOR_SECRET=
