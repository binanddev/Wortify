# Native Linux deployment: copy to Backend/.env; never commit the real file.
DJANGO_ENV=production
DJANGO_DEBUG=0
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=learn.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://learn.example.com
DJANGO_TRUST_PROXY=1
DJANGO_DATABASE_ENGINE=postgresql
DJANGO_DB_NAME=wortify
DJANGO_DB_USER=wortify
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=5432
DJANGO_DB_SSLMODE=prefer
DJANGO_MEDIA_ROOT=private_media
DJANGO_STATIC_ROOT=staticfiles
BACKEND_MONITOR_SECRET=
