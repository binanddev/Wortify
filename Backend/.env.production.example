# Import values into Render; never copy this over Backend/.env.
DJANGO_ENV=production
DJANGO_DEBUG=0
# Blueprint generates this automatically. For manual setup use a random 64+ character key.
DJANGO_SECRET_KEY=
DATABASE_URL=
FRONTEND_ORIGIN=https://your-site.netlify.app
MEDIA_STORAGE=s3
AWS_STORAGE_BUCKET_NAME=wortify-media
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
