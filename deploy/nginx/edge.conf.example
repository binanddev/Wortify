# Host Nginx on the frontend machine. Replace learn.example.com and certificate paths.
server { listen 443 ssl default_server; ssl_reject_handshake on; }
server { listen 80 default_server; server_name _; return 444; }
server { listen 80; server_name learn.example.com; return 308 https://learn.example.com$request_uri; }
server {
    listen 443 ssl;
    server_name learn.example.com;
    ssl_certificate /etc/letsencrypt/live/learn.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/learn.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 201m;
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_request_buffering off;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }
}
