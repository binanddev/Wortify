# This container is only reachable via the HTTPS edge proxy on the same machine.
server {
    listen 80;
    server_name ${PUBLIC_HOST};
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 201m;
    location ~ ^/(api|admin)(/|$) {
        proxy_pass ${BACKEND_ORIGIN};
        proxy_http_version 1.1;
        proxy_set_header Host ${PUBLIC_HOST};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 10s;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        proxy_request_buffering off;
        proxy_buffering off;
    }
    location /static/admin/ {
        proxy_pass ${BACKEND_ORIGIN};
        proxy_set_header Host ${PUBLIC_HOST};
        proxy_set_header X-Forwarded-Proto https;
    }
    location /static/react/ { alias /usr/share/nginx/html/; }
    location /assets/ { try_files $uri =404; expires 1y; add_header Cache-Control "public, immutable"; }
    location /private_media/ { return 404; }
    location = /index.html { add_header Cache-Control "no-cache"; }
    location / { try_files $uri $uri/ /index.html; }
}
