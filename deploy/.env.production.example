COMPOSE_PROJECT_NAME=wortify-prod
DJANGO_ENV=production
PUBLIC_HOST=learn.example.com
# Generate distinct random secrets. Do not use example credentials in production.
DJANGO_SECRET_KEY=
DJANGO_DB_PASSWORD=
DJANGO_DB_NAME=wortify
DJANGO_DB_USER=wortify
DJANGO_HSTS_SECONDS=3600
DJANGO_HSTS_INCLUDE_SUBDOMAINS=0
WEB_CONCURRENCY=2
WEB_THREADS=4
# Split deployment only: private/VPN address of the backend machine.
BACKEND_BIND_IP=10.20.0.2
STT_PROVIDER=
TTS_PROVIDER=
SPEECH_API_KEY=
FRONTEND_PORT=8080

# Shared only between the frontend monitor process and backend, never VITE_*.
BACKEND_MONITOR_SECRET=
