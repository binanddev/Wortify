# Replace domain, certificate paths, frontend root and API upstream.
server {
    listen 80;
    server_name learn.example.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name learn.example.com;
    ssl_certificate /etc/letsencrypt/live/learn.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/learn.example.com/privkey.pem;
    root /srv/wortify/frontend/dist;
    index index.html;
    client_max_body_size 210m;

    location /api/ {
        # Two servers: use the backend private IP instead of 127.0.0.1.
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 150s;
    }
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    location /audio/ { try_files $uri =404; }
    location / { try_files $uri $uri/ /index.html; add_header Cache-Control "no-cache"; }
    location ~ /\. { deny all; }
}
